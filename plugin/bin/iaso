#!/bin/sh
# iaso in the plugin's own environment (SP7 4.2, DEC-023, SR-082). Never the repository's
# .venv, never a iaso found on the PATH: iaso's private copy, per user and per plugin
# version, built once from the wheel the plugin carries (vendor/).
#   IASO_HOME = $IASO_HOME, else $CLAUDE_PLUGIN_DATA, else ~/.iaso
#   the environment: IASO_HOME/env/<version>-<wheel sha256, first 12>/
#   IASO_HOME/current.json {python, version, wheel_sha256, plugin_root} names the ready one
# When current.json is missing or names another wheel, this builds it under a lock
# (mkdir IASO_HOME/lock; a lock older than 10 minutes is taken over), with uv when present,
# else the first Python 3.12 or later of python3.12, python3, python, `py -3.12`, `py -3`
# (-m venv and pip); then writes the user-level launcher IASO_HOME/bin/iaso (git's hooks and
# the merge driver call it) and keeps the two newest environments.
# `iaso --iaso-bootstrap` only sets the environment up (the session-start hook runs it in
# the background) and exits with the build's own code: 2 when no Python can build it, and the
# half-built folder removed and the lock released on any failure (SR-119).
# `iaso --iaso-probe` exits 0 when this machine can build the environment, else 2: the one
# probe, so the session-start hook and the build never disagree (SR-119 EX-3).
nl='
'

slashes() {
  s=$1
  while :; do
    case $s in
      *\\*) s="${s%%\\*}/${s#*\\}" ;;
      *) break ;;
    esac
  done
  printf '%s' "$s"
}

field() {
  v=${1#*\"$2\"}
  [ "$v" = "$1" ] && return 0
  v=${v#*\"}
  printf '%s' "${v%%\"*}"
}

read_file() {
  f=
  while IFS= read -r l || [ -n "$l" ]; do f="$f$l$nl"; done < "$1"
  printf '%s' "$f"
}

mixed() {  # a path every process can open (C:/x on Windows, unchanged elsewhere)
  if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi
}

here=$(slashes "$0")
here=${here%/*}
[ "$here" = "$0" ] && here=.
plugin_root=$(cd "$here/.." && pwd)
plugin_root=$(mixed "$plugin_root")
IASO_HOME=$(slashes "${IASO_HOME:-${CLAUDE_PLUGIN_DATA:-$HOME/.iaso}}")
IASO_PLUGIN_ROOT=$plugin_root
export IASO_HOME IASO_PLUGIN_ROOT

manifest=$(read_file "$plugin_root/vendor/MANIFEST.json")
want=$(field "$manifest" sha256)
version=$(field "$manifest" version)
wheel=$(field "$manifest" wheel)
python=

ready() {
  [ -f "$IASO_HOME/current.json" ] || return 1
  current=$(read_file "$IASO_HOME/current.json")
  [ -n "$want" ] && [ "$(field "$current" wheel_sha256)" = "$want" ] || return 1
  python=$(field "$current" python)
  [ -n "$python" ] && [ -f "$python" ]
}

venv_python() {  # the platform's own layout first: a venv from the other OS cannot run
  if [ "$OS" = Windows_NT ]; then
    if [ -f "$1/Scripts/python.exe" ]; then printf '%s' "$1/Scripts/python.exe"
    else printf '%s' "$1/bin/python"; fi
  elif [ -f "$1/bin/python" ] || [ ! -f "$1/Scripts/python.exe" ]; then printf '%s' "$1/bin/python"
  else printf '%s' "$1/Scripts/python.exe"; fi
}

unlock() {
  rm -rf "$IASO_HOME/lock"
  trap - EXIT INT TERM
}

base=
pyflag=
run_py() {  # the chosen Python ($base, with $pyflag for the Windows launcher py)
  if [ -n "$pyflag" ]; then "$base" "$pyflag" "$@"; else "$base" "$@"; fi
}

probe() {  # base/pyflag = what builds the environment: uv, else a Python 3.12 or later
  if command -v uv >/dev/null 2>&1; then
    base=uv
    pyflag=
    return 0
  fi
  # python.org's Windows install has python.exe and py.exe, no python3.12: every name is
  # tried, each one checked for its version (a Windows Store stub or an old Python fails it)
  for candidate in python3.12 python3 python py:-3.12 py:-3; do
    base=${candidate%%:*}
    pyflag=
    [ "$base" = "$candidate" ] || pyflag=${candidate#*:}
    command -v "$base" >/dev/null 2>&1 || continue
    run_py -c 'import sys; sys.exit(sys.version_info[:2] < (3, 12))' >/dev/null 2>&1 &&
      return 0
  done
  base=
  pyflag=
  return 2
}

build() {  # $1: the folder to build the environment in; returns the failing step's code
  if [ -z "$base" ] && ! probe; then
    echo "iaso needs Python 3.12 on this machine; say 'install what iaso needs' and I will set it up" >&2
    return 2
  fi
  if [ "$base" = uv ]; then
    uv venv --quiet --relocatable --python 3.12 "$1" >&2 || return $?
    uv pip install --quiet --python "$(venv_python "$1")" "$plugin_root/vendor/$wheel" >&2
    return $?
  fi
  run_py -m venv "$1" >&2 || return $?
  "$(venv_python "$1")" -m pip install --quiet "$plugin_root/vendor/$wheel" >&2
}

bootstrap() {
  [ -n "$want" ] && [ -n "$wheel" ] || {
    echo "iaso: the plugin's copy of iaso is missing; reinstall the plugin" >&2
    return 1
  }
  # the probe first: a machine with no Python is left with nothing under IASO_HOME
  if ! probe; then
    echo "iaso needs Python 3.12 on this machine; say 'install what iaso needs' and I will set it up" >&2
    return 2
  fi
  mkdir -p "$IASO_HOME" || return 1
  # a stale lock is found with the POSIX find (/usr/bin/find under Git for Windows' sh too):
  # the bare name may reach Windows' FIND.EXE, which knows no -mmin and never says stale
  finder=find
  [ -x /usr/bin/find ] && finder=/usr/bin/find
  waited=0
  until mkdir "$IASO_HOME/lock" 2>/dev/null; do
    if [ -n "$("$finder" "$IASO_HOME/lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
      rm -rf "$IASO_HOME/lock"
      continue
    fi
    ready && return 0
    if [ "$waited" -ge 600 ]; then
      echo "iaso: still waiting for another session to set iaso up; try again shortly" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  trap unlock EXIT INT TERM
  if ready; then
    unlock
    return 0
  fi
  name="$version-$(printf '%.12s' "$want")"
  env="$IASO_HOME/env/$name"
  mkdir -p "$IASO_HOME/env" "$IASO_HOME/bin"
  rm -rf "$env.tmp"
  # the build's own code (`if ! build` would leave $? at 0): 2 when no Python can build it
  build "$env.tmp"
  code=$?
  if [ "$code" -ne 0 ]; then
    rm -rf "$env.tmp"
    unlock
    return $code
  fi
  rm -rf "$env"
  mv "$env.tmp" "$env" || { unlock; return 1; }
  python=$(mixed "$(venv_python "$env")")
  printf '{"python": "%s", "version": "%s", "wheel_sha256": "%s", "plugin_root": "%s"}\n' \
    "$python" "$version" "$want" "$plugin_root" > "$IASO_HOME/current.json.tmp"
  mv "$IASO_HOME/current.json.tmp" "$IASO_HOME/current.json"
  # the user-level launcher: git's hooks and the merge driver call it (SP7 4.6)
  printf '#!/bin/sh\nexport IASO_HOME="%s" IASO_PLUGIN_ROOT="%s"; exec "%s" -m iaso "$@"\n' \
    "$IASO_HOME" "$plugin_root" "$python" > "$IASO_HOME/bin/iaso"
  chmod +x "$IASO_HOME/bin/iaso" 2>/dev/null
  printf '@set "IASO_HOME=%s"\r\n@set "IASO_PLUGIN_ROOT=%s"\r\n@"%s" -m iaso %%*\r\n' \
    "$(mixed "$IASO_HOME")" "$plugin_root" "$python" > "$IASO_HOME/bin/iaso.cmd"
  # keep the two newest environments
  n=0
  for old in $(ls -1t "$IASO_HOME/env" 2>/dev/null); do
    case $old in *.tmp) continue ;; esac
    n=$((n + 1))
    [ "$n" -gt 2 ] && [ "$old" != "$name" ] && rm -rf "$IASO_HOME/env/$old"
  done
  unlock
  return 0
}

if [ "$1" = --iaso-probe ]; then
  probe
  exit $?
fi
if [ "$1" = --iaso-bootstrap ]; then
  ready && exit 0
  bootstrap
  exit $?
fi
ready || bootstrap || exit $?
ready || exit 1
exec "$python" -m iaso "$@"
