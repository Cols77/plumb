{
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m plumb statusline"
  },
  "env": {
    "PLUMB_AGENT_SESSION": "claude-code"
  },
  "permissions": {
    "deny": [
      "Bash(plumb approve:*)",
      "Bash(uv run plumb approve:*)",
      "Bash(python -m plumb approve:*)",
      "Bash(.venv/Scripts/python.exe -m plumb approve:*)",
      "Bash(plumb revoke:*)",
      "Bash(uv run plumb revoke:*)",
      "Bash(python -m plumb revoke:*)",
      "Bash(.venv/Scripts/python.exe -m plumb revoke:*)",
      "Bash(plumb tests waive:*)",
      "Bash(uv run plumb tests waive:*)",
      "Bash(python -m plumb tests waive:*)",
      "Bash(.venv/Scripts/python.exe -m plumb tests waive:*)",
      "Bash(plumb triage --approve:*)",
      "Bash(uv run plumb triage --approve:*)",
      "Bash(python -m plumb triage --approve:*)",
      "Bash(.venv/Scripts/python.exe -m plumb triage --approve:*)",
      "Bash(plumb spec approve:*)",
      "Bash(uv run plumb spec approve:*)",
      "Bash(python -m plumb spec approve:*)",
      "Bash(.venv/Scripts/python.exe -m plumb spec approve:*)",
      "Bash(plumb config auto-approve:*)",
      "Bash(uv run plumb config auto-approve:*)",
      "Bash(python -m plumb config auto-approve:*)",
      "Bash(.venv/Scripts/python.exe -m plumb config auto-approve:*)",
      "Bash(plumb config show:*)",
      "Bash(uv run plumb config show:*)",
      "Bash(python -m plumb config show:*)",
      "Bash(.venv/Scripts/python.exe -m plumb config show:*)",
      "Bash(plumb turn start:*)",
      "Bash(uv run plumb turn start:*)",
      "Bash(python -m plumb turn start:*)",
      "Bash(.venv/Scripts/python.exe -m plumb turn start:*)",
      "Bash(plumb hook prompt:*)",
      "Bash(uv run plumb hook prompt:*)",
      "Bash(python -m plumb hook prompt:*)",
      "Bash(.venv/Scripts/python.exe -m plumb hook prompt:*)",
      "Bash(plumb conflict choose:*)",
      "Bash(uv run plumb conflict choose:*)",
      "Bash(python -m plumb conflict choose:*)",
      "Bash(.venv/Scripts/python.exe -m plumb conflict choose:*)",
      "Bash(*PLUMB_AGENT_SESSION*)",
      "Edit(.plumb/log/**)",
      "Write(.plumb/log/**)",
      "MultiEdit(.plumb/log/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m plumb hook session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m plumb hook prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m plumb hook post-edit",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m plumb hook stop"
          }
        ]
      }
    ]
  }
}
